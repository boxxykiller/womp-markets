# Copy to .env and fill in real values. .env is git-ignored.
# One .env at the repo root is shared by the Vite build, the server, docker
# compose and Caddy.

# ── EVE Online SSO (https://developers.eveonline.com/applications) ──
# The callback URL registered on the application must match EVE_REDIRECT_URI
# exactly, including scheme and trailing path.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_REDIRECT_URI=https://markets.example.com/EveCallback

# ── Market source ────────────────────────────────────────────────────────
# Optional. When both are set the citadel is seeded on first boot; leave them
# blank to configure it instead through the first-run wizard on /Settings.
# MARKET_STRUCTURE_ID is the Upwell structure id (a 13-digit number);
# MARKET_READER_CHARACTER is the name of a character with docking access
# whose token is used to read the structure's market.
MARKET_STRUCTURE_ID=
MARKET_READER_CHARACTER=
MARKET_POLL_INTERVAL_MINUTES=15
MARKET_RETENTION_DAYS=180

# ── Access control ───────────────────────────────────────────────────────
# Comma-separated ids. A character must match at least one entry across both
# lists to be allowed in. If BOTH lists are empty, every character is allowed
# — convenient for a private test instance, wide open in production.
ALLOWED_CORPORATION_IDS=
ALLOWED_ALLIANCE_IDS=
# Comma-separated character names that always get the admin role.
ADMIN_CHARACTER_NAMES=

# ── Jita 4-4 reference prices ────────────────────────────────────────────
# fuzzwork (batched, preferred) or esi (one request per type). Either way the
# other is used as a fallback when the primary fails.
JITA_PRICE_SOURCE=fuzzwork
JITA_REFRESH_INTERVAL_MINUTES=20

# ── EVE Static Data Export ───────────────────────────────────────────────
# How often to check developers.eveonline.com for a new SDE build. Set to 0
# to disable the scheduler and refresh manually from /Settings.
SDE_CHECK_INTERVAL_HOURS=12

# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
# Must be a long random string — sessions are signed with it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Reverse proxy / TLS (Caddy — automatic Let's Encrypt) ────────────────
SITE_DOMAIN=markets.example.com
LETSENCRYPT_EMAIL=

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=womp_markets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/womp_markets

# Only used by the integration test suite. When unset those tests skip and
# `npm test` still runs the unit suite.
DATABASE_URL_TEST=

# ── Local admin login (development only — bypasses EVE SSO) ──────────────
# When this is not exactly "true" the route isn't registered at all, so it
# 404s rather than 403s in production.
ENABLE_LOCAL_ADMIN_LOGIN=false
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=
